_line": 20, "start_col": 0, "start_line": 9}}, {"id": "SECTION:needs_laptop_recommendations", "kind": "Section", "label": "Recommendations for laptops", "meta": {"condition_ref": "CONDITION:user_needs_defined AND user.needs == 'laptop'", "inferred": true, "priority": 2, "triggers": ["topic:laptop_recommendation"]}, "range": {"end_col": 0, "end_line": 13, "start_col": 4, "start_line": 11}}, {"id": "SECTION:needs_headphones_recommendations", "kind": "Section", "label": "Recommendations for headphones", "meta": {"condition_ref": "CONDITION:user_needs_defined AND user.needs == 'headphones'", "inferred": true, "priority": 2, "triggers": ["topic:headphones_recommendation"]}, "range": {"end_col": 0, "end_line": 16, "start_col": 4, "start_line": 14}}, {"id": "SECTION:no_specific_needs", "kind": "Section", "label": "No specific needs provided", "meta": {"condition_ref": "CONDITION:user_needs_defined AND user.needs != 'laptop' AND user.needs != 'headphones'", "inferred": true, "priority": 3, "triggers": ["topic:no_specific_needs"]}, "range": {"end_col": 0, "end_line": 18, "start_col": 4, "start_line": 17}}, {"id": "SECTION:collect_user_info", "kind": "Section", "label": "Collect user information when needs/budget not specified", "meta": {"condition_ref": "NOT (CONDITION:user_specified_budget AND CONDITION:user_needs_defined)", "inferred": true, "priority": 1, "triggers": ["topic:user_info_collection"]}, "range": {"end_col": 0, "end_line": 21, "start_col": 4, "start_line": 19}}, {"id": "BREAKPOINT:budget_check", "kind": "Breakpoint", "label": "Check if user has specified a budget", "meta": {"condition_ref": "CONDITION:user_specified_budget", "inferred": false}, "range": {"end_col": 50, "end_line": 23, "start_col": 0, "start_line": 23}}], "uri": "./corpus/synthetic/gen_013_recommend_products.prompt.rtpl", "version": 1}