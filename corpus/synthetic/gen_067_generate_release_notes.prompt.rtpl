Major Release!
{% endif %}

// @rule RULE:format_changes category=format priority=3
### Changes

{% if changes %}
{% for change in changes %}
#### {{ change.type | capitalize }}

{{ change.description }}
{% if change.issue_link %}
[Issue]({{ change.issue_link }})
{% endif %}
{% endfor %}
{% else %}
No changes in this release.
{% endif %}

// @rule RULE:format_footer category=format priority=4
### Notes

{{ notes }}

