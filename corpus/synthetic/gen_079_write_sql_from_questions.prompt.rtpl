// @rule RULE:calculate_average category=style priority=4
Calculate the average value as requested.
SELECT AVG({{ question.find("of") | split | last }}) FROM {{ question.find("from") | split | last }};
{% elif question.contains("total") %}
// @rule RULE:calculate_total category=style priority=4
Calculate the total value as requested.
SELECT SUM({{ question.find("of") | split | last }}) FROM {{ question.find("from") | split | last }};
{% elif question.contains("count") %}
// @rule RULE:calculate_count category=style priority=4
Count the number of items as requested.
