// @condition CONDITION:is_major_release
{{ release.version.major }} > {{ previous_release.version.major }}

// @condition CONDITION:has_breaking_changes
{{ release.breaking_changes | length }} > 0

{% if is_major_release %}
# {{ release.version.full }} - Major Release

## Breaking Changes

{% if has_breaking_changes %}
* {% for change in release.breaking_changes %}
  {{ change }}
{% endfor %}
{% else %}
No breaking changes in this release.
{% endif %}

## New Features

{% for feature in release.new_features %}
* {{ feature }}
{% endfor %}

## Improvements

{% for improvement in release.improvements %}
* {{ improvement }}
{% endfor %}

## Bug Fixes

{% for fix in release.bug_fixes %}
* {{ fix }}
{% endfor %}

{% else %}
# {{ release.version.full }} - Minor Release

## New Features

{% for feature in release.new_features %}
* {{ feature }}
{% endfor %}

## Improvements

{% for improvement in release.improvements %}
* {{ improvement }}
{% endfor %}

## Bug Fixes

{% for fix in release.bug_fixes %}
* {{ fix }}
{% endfor %}

